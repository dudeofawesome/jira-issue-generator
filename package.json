{
  "name": "@jira-issue-generator/root",
  "version": "0.0.0-unversioned",
  "private": true,
  "homepage": "https://github.com/dudeofawesome/jira-issue-generator/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dudeofawesome/jira-issue-generator.git"
  },
  "license": "MIT",
  "author": "Louis Orleans <louis@orleans.io>",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm run -C packages/markdown-to-jira-markup build",
    "build": "pnpm run --recursive --aggregate-output build",
    "check": "concurrently --raw --group \"pnpm:test\" \"pnpm:lint\"",
    "dev": "pnpm run --recursive dev",
    "prelint": "pnpm run build",
    "lint": "pnpm run --recursive --aggregate-output lint && eslint . && tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "pnpm run --recursive --aggregate-output test --run && echo 'All tests passed.'"
  },
  "devDependencies": {
    "@code-style/code-style": "catalog:",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "npm": "please-use-pnpm"
  }
}
